; Original multiplayer tile RPG demo
config_version=5

[application]
config/name="渡口丢药"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.065, 0.09, 0.075, 1)
